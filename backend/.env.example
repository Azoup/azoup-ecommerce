PORT=3001
SUPABASE_URL=https://your-project.supabase.co
# Chave service_role (secret) — NÃO use VITE_SUPABASE_ANON_KEY / publishable do frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# Billing Confec (apiconfec) — cobrança R$ 97/loja na mesma assinatura Stripe
CONFEC_BILLING_URL=https://apiconfec.azoup.com.br
# Mesmo valor de ECOMMERCE_BILLING_API_KEY no apiconfec (opcional)
# CONFEC_BILLING_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@azoup.com.br

# ============================================================
# App Nuvemshop Azoup (desenvolvedor — backend/.env apenas)
# ============================================================
# Onde obter:
# 1. Acesse https://partners.nuvemshop.com.br/ (ou https://www.nuvemshop.com.br/partners)
# 2. Crie/login na conta de parceiro/desenvolvedor
# 3. Crie um aplicativo (app) para o Azoup E-commerce
# 4. Copie Client ID e Client Secret do app
# 5. Em "Redirect URI" / URL de callback do app, cadastre EXATAMENTE:
#    http://localhost:3001/api/marketplace/nuvemshop/callback
#    (em produção: https://seu-dominio-api/api/marketplace/nuvemshop/callback)
#
# Cada LOJA cliente só clica "Conectar" na tela Configurações — não precisa
# de Client ID/Secret. O token OAuth de cada loja fica em marketplace_integracao.

NUVEMSHOP_CLIENT_ID=
NUVEMSHOP_CLIENT_SECRET=
# Redirect URI — cadastre EXATAMENTE uma destas URLs no app Nuvemshop (Partners):
# Opção A (direto no backend, recomendado em produção):
#   https://SUA-API/api/marketplace/nuvemshop/callback
# Opção B (relay pelo frontend — se o app e-commerce estiver em FRONTEND_URL):
#   https://SEU-FRONTEND/oauth/nuvemshop/callback
# NÃO use https://azoup.com.br/ sem o relay — o code OAuth não será processado.
# Use a mesma URL cadastrada no app Nuvemshop (Partners):
NUVEMSHOP_REDIRECT_URI=http://localhost:5173/oauth/nuvemshop/callback
NUVEMSHOP_USER_AGENT=AzoupEcommerce (contato@azoup.com.br)
NUVEMSHOP_API_VERSION=2025-03

# Chave AES-256 para criptografar tokens OAuth das lojas em repouso (32+ chars aleatórios)
TOKEN_ENCRYPTION_KEY=

# Estoque e-commerce (opcional — se omitido, usa ponto da empresa ou ponto padrão do tenant)
# MARKETPLACE_PONTA_ESTOQUE_ID=
# MARKETPLACE_INTEGRACAO_USUARIO_ID=

# Webhook para sincronizar preços ao salvar produto no Azoup (produto_cor_tamanho_tabela_preco)
# Configure Database Webhook no Supabase ou chame POST /api/marketplace/webhooks/product-price-changed
# MARKETPLACE_WEBHOOK_SECRET=  (mesmo valor usado no trigger SQL e no Supabase Database Webhook)

# Webhook estoque Azoup → Nuvemshop (estoque_movimentacao) — ver database/marketplace_stock_sync_webhook.sql
# Produção apiconfec: deploy/apiconfec/README.md + MARKETPLACE_WEBHOOK_SECRET = marketplace_webhook_settings

# ============================================================
# App Tray Commerce Azoup (desenvolvedor — backend/.env apenas)
# ============================================================
# Onde obter:
# 1. Cadastre o aplicativo na Central do Parceiro Tray: https://partners.tray.com.br/
# 2. Após aprovação, receba consumer_key e consumer_secret por e-mail
# 3. Cadastre a URL de callback do app (mesma de TRAY_REDIRECT_URI abaixo)
# 4. Configure a URL de webhook no app Tray: {BACKEND_URL}/api/marketplace/webhooks/tray
#
# Cada LOJA cliente informa a URL da loja (ex.: https://loja.commercesuite.com.br)
# ao clicar "Adicionar loja" → Tray → autoriza o app.
#
# Desabilitada por padrão enquanto a Nuvemshop é testada. Para reativar: TRAY_INTEGRATION_ENABLED=true
TRAY_INTEGRATION_ENABLED=false

TRAY_CONSUMER_KEY=
TRAY_CONSUMER_SECRET=
TRAY_REDIRECT_URI=http://localhost:5173/oauth/tray/callback
